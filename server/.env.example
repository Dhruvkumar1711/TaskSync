PORT=8000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here

# PostgreSQL connection options:
# Option 1: Standard PG credentials
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=tasksync

# Option 2: Cloud Database URL (Supabase, Neon, Render, etc.)
# DATABASE_URL=postgresql://username:password@hostname:5432/tasksync
